# SupportFlow environment template. Placeholders only. NEVER commit real values.
# Copy to .env for local development.

NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_USER=supportflow
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=supportflow
POSTGRES_TEST_DB=supportflow_test
# Mode B (everything in Compose): host is the service name 'postgres'
DATABASE_URL=postgres://supportflow:change_me_local_only@postgres:5432/supportflow
# Mode A (Node in WSL, infra in Docker): use localhost instead, e.g.
# DATABASE_URL=postgres://supportflow:change_me_local_only@localhost:5432/supportflow

# Redis
# Mode B: service name. Mode A: redis://localhost:6379
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Auth
JWT_ACCESS_SECRET=generate_at_least_32_random_bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_FAMILY_MAX_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
COOKIE_SECURE=false
PASSWORD_HASH_ALGORITHM=argon2id
DEFAULT_ORGANIZATION_SLUG=demo-org

# AI providers (mock needs no keys)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=mock-hash-v1
EMBEDDING_DIMENSIONS=384
EMBEDDING_CONFIG_NAME=mock-hash-v1-384
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_LIMIT=50
RETRIEVAL_MIN_SIMILARITY=0.30
AI_REQUESTS_PER_USER_PER_HOUR=30
LLM_TIMEOUT_MS=30000

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/data/storage
STORAGE_URL_SIGNING_SECRET=generate_at_least_32_random_bytes
SIGNED_URL_TTL_SECONDS=60
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=300
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chunking
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120

# Queue
INGEST_JOB_ATTEMPTS=4
INGEST_BACKOFF_MS=5000
WORKER_CONCURRENCY=2
RECONCILER_INTERVAL_MINUTES=5
STUCK_JOB_MINUTES=15

# Frontend (build time)
VITE_API_URL=http://localhost:4000/api/v1

# Dev-only seeding (the seed script refuses to run when NODE_ENV=production)
SEED_DEMO_PASSWORD=change_me_demo_only
